{
  "name": "clio-figure-explorer",
  "displayName": "Clio – Figure Explorer",
  "description": "Clio: browse figures from Jupyter notebooks and saved images.",
  "version": "0.1.25",
  "publisher": "LPurcell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucas-Purcell/clio"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Notebooks",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:figureExplorer.figures",
    "onCommand:figure-explorer.scanNotebook",
    "onNotebook:jupyter-notebook"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/icon.png",
  "files": [
    "dist/**",
    "resources/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Clio Gallery",
      "properties": {
        "clio.gallery.buttonStyle": {
          "type": "string",
          "enum": [
            "icons",
            "labels"
          ],
          "default": "icons",
          "enumDescriptions": [
            "Show compact icon buttons.",
            "Show icons with text labels where space permits."
          ],
          "description": "Choose how Clio Gallery action buttons are displayed."
        },
        "clio.gallery.thumbnailSize": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "default": "medium",
          "enumDescriptions": [
            "68 px thumbnails.",
            "88 px thumbnails.",
            "112 px thumbnails."
          ],
          "description": "Choose the fixed thumbnail size used by Clio Gallery."
        },
        "clio.gallery.compareLayout": {
          "type": "string",
          "enum": [
            "auto",
            "grid",
            "stack"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Choose a layout based on the number of figures and available space.",
            "Always arrange compared figures in a grid.",
            "Stack compared figures vertically."
          ],
          "description": "Choose the default layout for Clio Gallery comparison mode."
        },
        "clio.gallery.previewBackground": {
          "type": "string",
          "enum": [
            "transparent",
            "white"
          ],
          "default": "transparent",
          "enumDescriptions": [
            "Show the editor or sidebar theme behind transparent plot pixels.",
            "Show white behind transparent plot pixels for readable dark labels."
          ],
          "description": "Choose the background behind transparent figure previews."
        }
      }
    },
    "commands": [
      {
        "command": "figure-explorer.scanNotebook",
        "title": "Clio: Scan Notebook"
      },
      {
        "command": "figure-explorer.scanImages",
        "title": "Clio: Scan Images"
      },
      {
        "command": "figure-explorer.scanFolder",
        "title": "Clio: Scan Folder"
      },
      {
        "command": "figure-explorer.rescanSource",
        "title": "Clio: Rescan Source",
        "icon": "$(refresh)"
      },
      {
        "command": "figure-explorer.openSavedImage",
        "title": "Clio: Open Image"
      },
      {
        "command": "figure-explorer.unscanNotebook",
        "title": "Clio: Remove Scanned Source",
        "icon": "$(close)"
      },
      {
        "command": "figure-explorer.openFigure",
        "title": "Clio: Open Figure"
      },
      {
        "command": "figure-explorer.openNotebookGallery",
        "title": "Clio: Open Gallery"
      },
      {
        "command": "figure-explorer.openFigureGallery",
        "title": "Clio: Open Figure"
      },
      {
        "command": "figure-explorer.revealFigureCell",
        "title": "Clio: Reveal Cell"
      },
      {
        "command": "figure-explorer.saveFigureAsPng",
        "title": "Clio: Save Image"
      },
      {
        "command": "figure-explorer.exportFigureAsPdf",
        "title": "Clio: Export PDF"
      },
      {
        "command": "figure-explorer.openGalleryInEditor",
        "title": "Clio: Open Gallery in Editor"
      }
    ],
    "keybindings": [
      {
        "command": "figure-explorer.openGalleryInEditor",
        "key": "alt+g",
        "mac": "alt+g"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "figure-explorer.openFigureGallery",
          "when": "false"
        },
        {
          "command": "figure-explorer.openFigure",
          "when": "false"
        },
        {
          "command": "figure-explorer.openNotebookGallery",
          "when": "false"
        },
        {
          "command": "figure-explorer.revealFigureCell",
          "when": "false"
        },
        {
          "command": "figure-explorer.saveFigureAsPng",
          "when": "false"
        },
        {
          "command": "figure-explorer.exportFigureAsPdf",
          "when": "false"
        },
        {
          "command": "figure-explorer.rescanSource",
          "when": "false"
        },
        {
          "command": "figure-explorer.openSavedImage",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "figure-explorer.unscanNotebook",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.notebook",
          "group": "inline@1"
        },
        {
          "command": "figure-explorer.revealFigureCell",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@1"
        },
        {
          "command": "figure-explorer.saveFigureAsPng",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@2"
        },
        {
          "command": "figure-explorer.exportFigureAsPdf",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@3"
        },
        {
          "command": "figure-explorer.unscanNotebook",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.imageSource",
          "group": "inline@1"
        },
        {
          "command": "figure-explorer.rescanSource",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.imageSource",
          "group": "inline@2"
        },
        {
          "command": "figure-explorer.openSavedImage",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.image",
          "group": "navigation@1"
        },
        {
          "command": "figure-explorer.saveFigureAsPng",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.image",
          "group": "navigation@2"
        },
        {
          "command": "figure-explorer.exportFigureAsPdf",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.image",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "figureExplorer",
          "title": "Clio",
          "icon": "resources/Icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "figureExplorer.figures",
          "name": "Clio",
          "icon": "resources/Icon.svg"
        }
      ],
      "figureExplorer": [
        {
          "id": "figureExplorer.gallery",
          "name": "Clio Gallery",
          "type": "webview",
          "icon": "resources/Icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.8.69"
  }
}
